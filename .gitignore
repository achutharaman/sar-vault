# Dependencies
node_modules/
.pnp/
.pnp.js
.yarn/

# Build output
dist/
tmp/
out-tsc/
.angular/
*.tsbuildinfo

# Tool caches
.eslintcache
vite.config.*.timestamp-*
vitest.config.*.timestamp-*

# Testing
coverage/
.nyc_output/
/playwright-report/
/playwright/.cache/
/test-results/
/blob-report/

# Environment & secrets — never commit OAuth client config
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
*.docx
*.txt
# ...but published crypto known-answer vectors (NIST CAVP / RFC files ship as .txt)
# and static text assets must remain committable.
!**/fixtures/**/*.txt
!**/vectors/**/*.txt
!public/**/*.txt

# Local project/tooling config, not for the public repo
CLAUDE.md
.claude/

# Vault files — never commit a real or test vault with real data
*.kdbx
*.kdb
# ...but committed test fixtures are required: format round-trip tests need real
# KDBX files. Kept in step with the *.txt vector exemption above.
!**/fixtures/**/*.kdbx
!**/fixtures/**/*.kdb

# Editors — local editor config is personal, not project state
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Screenshots captured locally for review, not project state
screenshots/

# Generated from .env at build time — never committed
src/environments/generated.ts
