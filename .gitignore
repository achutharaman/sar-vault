# Dependencies
node_modules/
.pnp/
.pnp.js
.yarn/

# Build output
dist/
tmp/
out-tsc/
.angular/
*.tsbuildinfo

# Testing
coverage/
.nyc_output/
/playwright-report/
/playwright/.cache/
/test-results/
/blob-report/

# Environment & secrets — never commit OAuth client config
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
*.docx
*.txt
# ...but published crypto known-answer vectors (NIST CAVP / RFC files ship as .txt)
# and static text assets must remain committable.
!**/fixtures/**/*.txt
!**/vectors/**/*.txt
!public/**/*.txt

# Local project/tooling config, not for the public repo
CLAUDE.md
.claude/

# Vault files — never commit a real or test vault with real data
*.kdbx
*.kdb
!test/fixtures/**/*.kdbx

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log
