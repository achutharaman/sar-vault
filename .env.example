# OAuth client IDs for storage providers.
# These are PUBLIC identifiers used with PKCE — there is no client secret in a
# browser-only app. If you ever find yourself adding a *_SECRET here, stop:
# it would mean the architecture has gained a backend.

# Google Drive — scope: drive.file
# Not drive.appdata: that folder is hidden from the user, who then cannot see,
# back up or open their own vault in KeePassXC. See living-spec Q-008/D-019.
NG_APP_GOOGLE_CLIENT_ID=

# Microsoft OneDrive — scope: Files.ReadWrite.AppFolder
# OneDrive's app folder lives at Apps/sar-vault in the user's normal drive, so
# unlike Google's appdata it stays visible and backup-able.
NG_APP_MICROSOFT_CLIENT_ID=

# Redirect URI registered with each provider
NG_APP_OAUTH_REDIRECT_URI=http://localhost:4200/auth/callback
